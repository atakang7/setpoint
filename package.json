{
  "name": "setpoint-agent",
  "version": "0.1.0",
  "description": "Outcome control for coding agents.",
  "type": "module",
  "license": "MIT",
  "bin": { "setpoint": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run test && npm run build"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "commander": "^15.0.0",
    "openai": "^7.5.0",
    "playwright": "^1.62.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^4.1.11"
  }
}
